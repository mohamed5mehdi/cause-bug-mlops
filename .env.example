# Copier ce fichier en .env (ignore par git) et remplacer chaque valeur.
# Ne jamais versionner .env.

# Super-utilisateur PostgreSQL (administration uniquement)
POSTGRES_PASSWORD=a-remplacer

# Role applicatif d'erp-simule (proprietaire du schema erp)
ERP_APP_PASSWORD=a-remplacer

# Role lecture seule d'aiops-engine
AIOPS_READER_PASSWORD=a-remplacer

# Cle de l'API Gemini (embeddings, diagnostic). Facultative pour demarrer :
# sans elle, aiops-engine ingere les traces mais ne les vectorise pas.
# GEMINI_API_KEY=a-remplacer

# Ports exposes sur la machine hote (optionnels)
# PG_HOST_PORT=5435
# ERP_HOST_PORT=8080
# AIOPS_HOST_PORT=8000
